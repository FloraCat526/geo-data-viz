{
  "name": "@floracat/geo-data-viz",
  "version": "0.2.0",
  "description": "An independent AI agent skill for analyzing geographic data and generating interactive maps.",
  "type": "module",
  "bin": {
    "geo-data-viz": "bin/geo-data-viz.mjs"
  },
  "files": [
    "LICENSE",
    "SKILL.md",
    "agents/*.yaml",
    "scripts/*.py",
    "references/**/*.md",
    "assets/adapters/*.mjs",
    "assets/recipes/*.mjs",
    "assets/shared/*.mjs",
    "requirements-excel.txt",
    "bin/*.mjs",
    "assets/components/*.mjs",
    "assets/video/package.json",
    "assets/video/remotion.config.ts",
    "assets/video/tsconfig.json",
    "assets/video/gitignore.txt",
    "assets/video/src/*.jsx",
    "assets/video/scripts/*.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "examples": "node scripts/serve_examples.mjs",
    "examples:build": "python3 examples/build.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FloraCat526/geo-data-viz.git"
  },
  "homepage": "https://github.com/FloraCat526/geo-data-viz#readme",
  "bugs": {
    "url": "https://github.com/FloraCat526/geo-data-viz/issues"
  },
  "keywords": [
    "agent-skill",
    "codex",
    "geojson",
    "maps",
    "mapbox",
    "geospatial",
    "visualization"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
